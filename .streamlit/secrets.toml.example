# Copia este archivo a .streamlit/secrets.toml y rellena tus valores.
# NUNCA subas secrets.toml al repo (ya está en .gitignore).
#
# En Streamlit Cloud: Settings → Secrets → pega este bloque con valores reales.

# --- OpenAlex ---
OPENALEX_API_KEY = "tu_api_key_de_openalex"
OPENALEX_EMAIL = "tu_correo@institucion.edu.mx"   # cortesía / "polite pool"

# --- INEGI ---
INEGI_TOKEN = "tu_token_del_inegi"

# --- Banxico (SIE) ---
BANXICO_TOKEN = "tu_token_de_banxico"

# --- Google AI Studio (Gemini) ---
GEMINI_API_KEY = "tu_api_key_de_google_ai_studio"
